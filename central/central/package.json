{
  "name": "bg-boilerplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "roadshow": "npm run build && npm run preview",
    "lint": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "engines": "node >=20 || bun >=1.1"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.500.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^3.2.7",
    "tailwindcss": "^4.1.7",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^3.2.7"
  }
}
