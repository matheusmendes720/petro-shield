{
  "name": "petro-shield-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Unified PetroShield / AxeGuard monorepo — hub + 3 sub-apps built and deployed as a single Netlify site.",
  "engines": "node >=20 || bun >=1.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/test.mjs",
    "sync": "powershell -ExecutionPolicy Bypass -File scripts/sync.ps1",
    "sync:dry": "powershell -ExecutionPolicy Bypass -File scripts/sync.ps1 -DryRun"
  }
}
